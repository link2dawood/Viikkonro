{
  "name": "viikkonro",
  "private": false,
  "version": "1.0.0",
  "description": "Finnish ISO week-number and calendar utility built with React and Vite.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link2dawood/Viikkonro.git"
  },
  "homepage": "https://weekdays-link2dawoods-projects.vercel.app",
  "bugs": {
    "url": "https://github.com/link2dawood/Viikkonro/issues"
  },
  "keywords": [
    "calendar",
    "finnish",
    "week-number",
    "iso-8601",
    "date",
    "react",
    "vite",
    "open-source",
    "finland",
    "holiday"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node prerender.js",
    "build:spa": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "node src/cli.js check",
    "check:index": "node src/cli.js inspect",
    "check:crawl": "node scripts/check-crawl.js",
    "check:ad-crawlers": "node scripts/check-ad-crawlers.js",
    "check:traffic": "node src/cli.js traffic",
    "check:backlinks": "node scripts/check-backlinks.js",
    "report:seo": "node scripts/seo-report.js",
    "report:seo-growth": "node scripts/seo-growth-report.js",
    "sync:name-days": "node scripts/sync-name-days.js",
    "test": "vitest run",
    "test:predeploy:artifacts": "node --test scripts/predeploy-build.cases.mjs",
    "test:predeploy": "npm run lint && npm test && npm run build && npm run test:predeploy:artifacts && npx vite build --ssr src/entry-server.jsx --outDir dist-server && npm run check:crawl"
  },
  "dependencies": {
    "@sentry/react": "^11.6.0",
    "@vercel/og": "^1.0.3",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "suncalc": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "google-auth-library": "^10.9.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.10"
  }
}
