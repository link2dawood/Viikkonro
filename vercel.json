{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/week/:week/:year",
      "destination": "/viikko-:week-:year",
      "statusCode": 301
    },
    {
      "source": "/month/:month/:year",
      "destination": "/kuukausi-:month-:year",
      "statusCode": 301
    },
    {
      "source": "/year/:year",
      "destination": "/vuosi-:year",
      "statusCode": 301
    },
    {
      "source": "/print/:year",
      "destination": "/tulosta-:year",
      "statusCode": 301
    },
    {
      "source": "/pdfs/:file",
      "destination": "/pdf/:file",
      "statusCode": 301
    },
    {
      "source": "/api/week/:week/:year.json",
      "destination": "/data/week/:year/:week.json",
      "statusCode": 301
    },
    {
      "source": "/api/month/:month/:year.json",
      "destination": "/data/month/:year/:month.json",
      "statusCode": 301
    },
    {
      "source": "/api/year/:year.json",
      "destination": "/data/year/:year.json",
      "statusCode": 301
    },
    {
      "source": "/api/holiday/:slug/:year.json",
      "destination": "/data/holiday/:year/:slug.json",
      "statusCode": 301
    },
    {
      "source": "/kalenteri-:y(\\d+)-1",
      "destination": "/kalenteri-:y-alkuvuosi",
      "statusCode": 301
    },
    {
      "source": "/kalenteri-:y(\\d+)-2",
      "destination": "/kalenteri-:y-loppuvuosi",
      "statusCode": 301
    },
    {
      "source": "/what-is-a-week-number",
      "destination": "/mika-on-viikkonumero",
      "statusCode": 301
    },
    {
      "source": "/weeks-in-a-year",
      "destination": "/kuinka-monta-viikkoa-vuodessa",
      "statusCode": 301
    },
    {
      "source": "/about-us",
      "destination": "/tietoa-meista",
      "statusCode": 301
    },
    {
      "source": "/contact-us",
      "destination": "/ota-yhteytta",
      "statusCode": 301
    },
    {
      "source": "/cdn-cgi/l/email-protection",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/faq",
      "destination": "/ukk",
      "statusCode": 301
    },
    {
      "source": "/privacy-policy",
      "destination": "/tietosuoja",
      "statusCode": 301
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/kayttoehdot",
      "statusCode": 301
    },
    {
      "source": "/sv/vecka-:w(\\d+)-:y(\\d+)",
      "destination": "/viikko-:w-:y",
      "statusCode": 301
    },
    {
      "source": "/sv/veckor-:y(\\d+)",
      "destination": "/vuosi-:y",
      "statusCode": 301
    },
    {
      "source": "/sv/helgdagar-:y(\\d+)",
      "destination": "/pyhapaivat-:y",
      "statusCode": 301
    },
    {
      "source": "/sv",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/sv/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/kaupunki",
      "destination": "/auringonlasku",
      "statusCode": 301
    },
    {
      "source": "/kaupunki/:slug",
      "destination": "/auringonlasku-:slug",
      "statusCode": 301
    },
    {
      "source": "/pyhat-:year(1\\d{3}|20[01]\\d)/:slug",
      "destination": "/pyhat-2020/:slug",
      "statusCode": 301
    },
    {
      "source": "/viikko-:week(\\d{1,2})-:year(1\\d{3}|20[01]\\d)",
      "destination": "/viikko-:week-2020",
      "statusCode": 301
    },
    {
      "source": "/kuukausi-:month(\\d{1,2})-:year(1\\d{3}|20[01]\\d)",
      "destination": "/kuukausi-:month-2020",
      "statusCode": 301
    },
    {
      "source": "/q:quarter([1-4])-:year(1\\d{3}|20[01]\\d)",
      "destination": "/q:quarter-2020",
      "statusCode": 301
    },
    {
      "source": "/kalenteri-:year(1\\d{3}|20[01]\\d)-alkuvuosi",
      "destination": "/kalenteri-2020-alkuvuosi",
      "statusCode": 301
    },
    {
      "source": "/kalenteri-:year(1\\d{3}|20[01]\\d)-loppuvuosi",
      "destination": "/kalenteri-2020-loppuvuosi",
      "statusCode": 301
    },
    {
      "source": "/:family(tulostettava-kalenteri|elakkeen-maksupaivat|kelan-maksupaivat|tyopaivat-maaliskuu|tyopaivat-marraskuu|tyopaivat-helmikuu|tyopaivat-tammikuu|tyopaivat-huhtikuu|tyopaivat-heinakuu|tyopaivat-joulukuu|tyopaivat-toukokuu|tyopaivat-lokakuu|tyopaivat-syyskuu|tyopaivat-kesakuu|tyopaivat-elokuu|palkkapaivat|liputuspaivat|kuun-vaiheet|ystavanpaiva|pyhapaivat|aitienpaiva|laskiainen|isanpaiva|tyopaivat|kalenteri|kesaaika|adventti|tulosta|vuosi)-:year(1\\d{3}|20[01]\\d)",
      "destination": "/:family-2020",
      "statusCode": 301
    }
  ],
  "headers": [
      {
        "source": "/widget/calendar/(.*)",
        "headers": [
          { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'none'; img-src 'none'; font-src 'none'; frame-src 'none'; frame-ancestors *; base-uri 'none'; form-action 'none'; object-src 'none'" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-16xOB69q4Of4Coft2LmKc8OTdvZtRdahMFn0ninAJZ0=' https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://challenges.cloudflare.com https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net https://*.googletagservices.com https://*.gstatic.com https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.web3forms.com https://www.clarity.ms https://*.clarity.ms https://c.bing.com https://challenges.cloudflare.com https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net https://*.googletagservices.com https://*.gstatic.com https://*.adtrafficquality.google; frame-src 'self' https://challenges.cloudflare.com https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net https://*.googletagservices.com https://*.gstatic.com https://*.adtrafficquality.google; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://api.web3forms.com; object-src 'none'"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=3600"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\"; title=\"LLM-readable site summary\", </ukk>; rel=\"help\", </tietosuoja>; rel=\"privacy-policy\", </kayttoehdot>; rel=\"terms-of-service\""
        }
      ]
    },
    {
      "source": "/api/newsletter",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!widget/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/widget/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors *; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/ics/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)-viikkonro-(.*).svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|ads.txt|app-ads.txt|llms.txt|llms-full.txt|llms-api.txt|llms-data.txt|llms-glossary.txt|ai-manifest.txt|og.png|ai.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)/index.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/data/index.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*).csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
