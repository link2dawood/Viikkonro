# Public build settings. Leave blank until account setup and delivery are ready.
VITE_NEWSLETTER_ENDPOINT=
VITE_TURNSTILE_SITE_KEY=

# Browser-safe Supabase project URL and publishable key only. Never a secret/service-role key.
VITE_TEAM_SUPABASE_URL=
VITE_TEAM_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings. Store real values in .env.local or Vercel, never Git.
BUSINESS_API_SUPABASE_URL=
BUSINESS_API_SUPABASE_SECRET=
SITE_ORIGIN=https://viikkonro.fi
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
TURNSTILE_SECRET_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=

# Polar and commerce backend: SERVER ONLY. POLAR_ENABLED is a gradual launch switch.
POLAR_ENVIRONMENT=production
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_ID=
POLAR_PRICE_ID=
POLAR_WEBHOOK_SECRET=
POLAR_ENABLED=false
PURCHASE_SIGNING_SECRET=
BILLING_SITE_ORIGIN=https://viikkonro.fi
BILLING_SUPABASE_URL=
BILLING_SUPABASE_SECRET=
# Server-only recipient for BCC copies of customer invoices.
BILLING_OWNER_EMAIL=hi@viikkonro.fi
