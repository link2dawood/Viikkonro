# Copy to .env.local for local dev. In production set these as Vercel env vars.
VITE_WEB3FORMS_ACCESS_KEY=
# Sentry DSN (Project Settings > Client Keys). Leave empty to disable tracking.
# Defaults to the project DSN in production builds; set empty to disable.
VITE_SENTRY_DSN=
# Optional: release tag, e.g. the git SHA
VITE_SENTRY_RELEASE=
